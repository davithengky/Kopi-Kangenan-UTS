    {
      "name": "Pesanan",
      "item": [
        {
          "name": "Riwayat pesanan",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] } }
        },
        {
          "name": "Buat pesanan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('kode #1002+', () => pm.expect(body.data.code).to.match(/^#1[0-9]{3}$/));",
                  "pm.collectionVariables.set('orderId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"name\": \"Taro Cloud Latte\",\n      \"image\": \"assets/taro cloud latte.png\",\n      \"base_price\": 28000,\n      \"unit_price\": 28000,\n      \"quantity\": 2,\n      \"size\": \"Regular\",\n      \"milk\": \"Milk\",\n      \"sugar\": \"Normal Sugar\",\n      \"ice\": \"Normal Ice\",\n      \"toppings\": [],\n      \"syrups\": [],\n      \"note\": \"\"\n    }\n  ],\n  \"outlet_id\": 1,\n  \"bag_fee\": 2000,\n  \"voucher_code\": \"KANGENAN10\",\n  \"points_used\": 0,\n  \"payment_method_id\": \"qris\",\n  \"fulfilment\": \"Pickup\",\n  \"scheduled_at\": null\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "description": "Total = subtotal + bag_fee - voucher_discount - points_used (tidak negatif). Poin yang diminta melebihi saldo akan dipangkas otomatis."
          }
        },
        {
          "name": "Detail pesanan",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}"] } }
